14:["$","div",null,{"className":"article-layout","children":[["$","aside",null,{"className":"article-sidebar","children":[["$","nav",null,{"aria-label":"In this article","children":[["$","p",null,{"className":"eyebrow","children":"IN THIS ARTICLE"}],[["$","a","what-it-means",{"href":"#what-it-means","children":"Understand what body contouring means"}],["$","a","which-treatment",{"href":"#which-treatment","children":"Find out exactly what is being offered"}],["$","a","risks-and-expectations",{"href":"#risks-and-expectations","children":"Talk about limitations and possible side effects"}],["$","a","practical-details",{"href":"#practical-details","children":"Get the practical details in writing"}]]]}],["$","div",null,{"className":"sidebar-booking","children":[["$","span",null,{"aria-hidden":"true","children":"✳"}],["$","h2",null,{"children":["Your moment",["$","br",null,{}],"is waiting."]}],["$","p",null,{"children":"Facials, body care and time to unwind in Hamilton."}],["$","a",null,{"className":"text-link","href":"/slimmer-you-site/#booking","children":["Plan your visit ",["$","$Lb",null,{"ref":"$undefined","iconNode":"$3:1:props:children:props:children:props:children:props:children:props:fallback:0:1:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":16}]]}]]}]]}],["$","article",null,{"className":"article-body","children":[["$","p",null,{"className":"article-intro","children":"Body contouring is a broad term, so a clear conversation matters more than a catchy treatment name. If you are exploring options in Hamilton, bring questions about the specific service, the person providing it, and what a realistic plan would look like for you."}],["$","div",null,{"className":"article-takeaway","children":[["$","p",null,{"className":"eyebrow","children":"THE LITTLE TAKEAWAY"}],["$","p",null,{"children":"Know the exact treatment, understand its limitations, and ask about risks and suitability before deciding."}]]}],[["$","section","what-it-means",{"id":"what-it-means","children":[["$","h2",null,{"children":"Understand what body contouring means"}],[["$","p","Non-invasive body contouring refers to procedures intended to change the appearance or shape of a body area without surgery. It is not a weight-loss treatment. The U.S. Food and Drug Administration explains that these procedures do not treat obesity or provide the health benefits associated with weight loss; results and risks depend on the technology and the individual.",{"children":"Non-invasive body contouring refers to procedures intended to change the appearance or shape of a body area without surgery. It is not a weight-loss treatment. The U.S. Food and Drug Administration explains that these procedures do not treat obesity or provide the health benefits associated with weight loss; results and risks depend on the technology and the individual."}],["$","p","That distinction helps frame a useful consultation. Describe the specific change you are considering and ask whether the proposed treatment is intended for that purpose. A procedure being non-surgical does not mean it is suitable for everyone.",{"children":"That distinction helps frame a useful consultation. Describe the specific change you are considering and ask whether the proposed treatment is intended for that purpose. A procedure being non-surgical does not mean it is suitable for everyone."}]],"$undefined",["$","p",null,{"className":"article-source","children":["Further reading: ",["$","a",null,{"href":"https://www.fda.gov/medical-devices/aesthetic-cosmetic-devices/non-invasive-body-contouring-technologies","target":"_blank","rel":"noreferrer","children":["FDA: Non-invasive body contouring technologies"," ↗"]}]]}]]}],["$","section","which-treatment",{"id":"which-treatment","children":[["$","h2",null,{"children":"Find out exactly what is being offered"}],[["$","p","“Body contouring” can describe different services. Ask for the treatment name, device name if one is used, and the area it is intended to treat. Ask the provider to explain the process in plain language and tell you about their training for that specific procedure.",{"children":"“Body contouring” can describe different services. Ask for the treatment name, device name if one is used, and the area it is intended to treat. Ask the provider to explain the process in plain language and tell you about their training for that specific procedure."}],"$L17"],"$L18","$undefined"]}],"$L19","$L1a"],"$L1b"]}]]}]
