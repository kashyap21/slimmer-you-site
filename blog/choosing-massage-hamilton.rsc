18:["$","section","comfort",{"id":"comfort","children":[["$","h2",null,{"children":"Make comfort part of the conversation"}],[["$","p","Ask how the session will be arranged, what clothing or draping to expect, and how to communicate your preferences. You can ask questions before the treatment begins. Mention if you would prefer less conversation, have an area you do not want touched, or want an explanation before each step.",{"children":"Ask how the session will be arranged, what clothing or draping to expect, and how to communicate your preferences. You can ask questions before the treatment begins. Mention if you would prefer less conversation, have an area you do not want touched, or want an explanation before each step."}],["$","p","During the appointment, speak up if pressure or positioning feels uncomfortable. You can ask for an adjustment, a pause or for the session to stop. A first visit does not require you to know all your preferences in advance; you can communicate as you go.",{"children":"During the appointment, speak up if pressure or positioning feels uncomfortable. You can ask for an adjustment, a pause or for the session to stop. A first visit does not require you to know all your preferences in advance; you can communicate as you go."}]],["$","ul",null,{"children":[["$","li","What type of massage is being offered?",{"children":"What type of massage is being offered?"}],["$","li","Who will provide it, and what are their credentials?",{"children":"Who will provide it, and what are their credentials?"}],["$","li","How long is the session, and what does it cost?",{"children":"How long is the session, and what does it cost?"}],["$","li","How should I communicate pressure and comfort preferences?",{"children":"How should I communicate pressure and comfort preferences?"}]]}],"$undefined"]}]
19:["$","section","arrange-your-time",{"id":"arrange-your-time","children":[["$","h2",null,{"children":"Leave room for an unhurried visit"}],[["$","p","Once you have confirmed the duration, allow enough time for the trip to Upper Wellington Street and any questions before your session. Ask the spa about arrival instructions. If you are fitting the visit between other commitments, explain your timing rather than guessing how quickly you can leave.",{"children":"Once you have confirmed the duration, allow enough time for the trip to Upper Wellington Street and any questions before your session. Ask the spa about arrival instructions. If you are fitting the visit between other commitments, explain your timing rather than guessing how quickly you can leave."}],["$","p","Request a preferred time through our calendar, then call 365-833-0170 to confirm. There is no online payment step. Your booking request is an invitation to arrange the details, so use that conversation to make the experience feel right for you.",{"children":"Request a preferred time through our calendar, then call 365-833-0170 to confirm. There is no online payment step. Your booking request is an invitation to arrange the details, so use that conversation to make the experience feel right for you."}]],"$undefined","$undefined"]}]
